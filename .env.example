# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Postgres ---
# Used by docker-compose to initialize the postgres container,
# and by local tools (alembic, pytest) run on the host via DATABASE_URL.
POSTGRES_USER=meet
POSTGRES_PASSWORD=meet
POSTGRES_DB=meet_intelligence
DATABASE_URL=postgresql+psycopg://meet:meet@localhost:5432/meet_intelligence

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- S3-compatible object storage ---
# Local dev runs Zenko CloudServer (free, S3-API-compatible) instead of MinIO's own
# image, which now requires a paid Docker Hub subscription to pull. Point these at
# real MinIO, S3, or R2 in staging/prod without changing any code.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=accessKey1
MINIO_SECRET_KEY=verySecretKey1
MINIO_BUCKET=meet-intelligence
MINIO_SECURE=false

# --- ASR (Phase 4+, not used yet) ---
# Gated HF model (bodhan-ai/indic-transcribe-*). Accept the license on
# huggingface.co for the model first, then paste a read token here.
HF_TOKEN=

# --- LLM for meeting analysis (Phase 5+, not used yet) ---
LLM_PROVIDER=openai
LLM_API_KEY=

# --- Google Calendar booking trigger ---
# "service_account" = domain-wide delegation, impersonates each employee (prod).
# "oauth" = a single user's stored refresh token (local dev / single-user setups).
# fincelerate.com uses service_account; see README "Domain-wide delegation".
CALENDAR_AUTH_MODE=service_account
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json
GOOGLE_OAUTH_CLIENT_FILE=
GOOGLE_OAUTH_TOKEN_FILE=oauth_token.json
# Comma-separated list of calendars to watch, one per employee.
EMPLOYEE_EMAILS=it@fincelerate.com
# Defaults to "primary"; set to a shared calendar id to watch one calendar instead.
CALENDAR_ID=primary
# Only process events whose title starts with this (optional).
EVENT_TITLE_PREFIX=30 min with Information
CALENDAR_POLL_SECONDS=180
# Requires the calendar.events scope. See README "Optional: auto-add the bot as a guest".
AUTO_ADD_BOT_GUEST=true

# --- Bot account pool ---
BOT_HEARTBEAT_TIMEOUT_SECONDS=180
# Reservation window is [scheduled_at - LEAD, scheduled_at + TAIL).
BOT_RESERVATION_LEAD_SECONDS=120
BOT_RESERVATION_TAIL_SECONDS=1800
